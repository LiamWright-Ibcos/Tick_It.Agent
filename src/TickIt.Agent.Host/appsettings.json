{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Polling": {
    "IntervalSeconds": 300
  },

  "Audit": {
    "LogFilePath": "audit-log.jsonl"
  },

  "Classifier": {
    "AnthropicApiKey": null,
    "Model": "claude-sonnet-4-5",
    "MaxOutputTokens": 1024
  },

  "Atlassian": {
    "SiteBaseUrl": null,
    "BearerToken": null,
    "Jql": "project = GOLD",
    "MaxResults": 5
  },

  "ActionExecutor": {
    "UseLiveExecutor": false,
    "EnableLiveNotifications": false,
    "EnableLiveTier2Actions": false,
    "Tier2HumanOverrideWindowMinutes": 30
  },

  "TeamsNotification": {
    "WebhookUrl": null
  },

  "McpServer": {
    "DllPath": null
  }
}
